# ---------- LLM provider (swappable) ----------
# anthropic  : Claude via the Anthropic API, needs ANTHROPIC_API_KEY
# ollama     : any local model served by Ollama, free and offline
# extractive : no LLM at all, the answer is stitched from your notes (zero setup)
LLM_PROVIDER=extractive

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.0

# ---------- embeddings (local, free) ----------
EMBED_MODEL=BAAI/bge-small-en-v1.5
# sentence-transformers | hash  (hash = offline, no model download, lexical only)
EMBED_BACKEND=sentence-transformers
EMBED_BATCH_SIZE=32

# ---------- chunking ----------
CHUNK_TOKENS=500
CHUNK_OVERLAP=80
MIN_CHUNK_CHARS=40

# ---------- library tiers ----------
# Tier stamped on chunks at ingest time. 'curated' = your own vetted notes.
# Contributed material is written as 'private' and only an approval moves it
# to 'community'. Do not set this to community.
DEFAULT_VISIBILITY=curated

# The prompt-injection scanner runs at ingest and logs what it finds. It may
# only start blocking once it reports zero hard hits across your own corpus
# (there is a test for exactly that). Leave false until then.
INJECTION_ENFORCE=false

# ---------- uploads ----------
# Both paths sit outside data/index and data/pdfs on purpose: rebuilding the
# index wipes data/index, and anything under data/pdfs is treated as curated.
REGISTRY_PATH=data/registry.db
UPLOAD_DIR=data/uploads
# Whoever logs in with this address is the single approver. Unset = nobody.
OWNER_EMAIL=
UPLOAD_MAX_MB=25
UPLOAD_MAX_PAGES=400
QUOTA_DOCS_TOTAL=30
QUOTA_BYTES_TOTAL=314572800

# ---------- retrieval ----------
TOP_K=5
FETCH_K=20
# lexical | cross-encoder | none
RERANKER=lexical
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base

# ---------- web service ----------
CORS_ORIGINS=http://localhost:3000
API_RATE_LIMIT=20
API_RATE_WINDOW=60

# ---------- storage ----------
PDF_DIR=data/pdfs
INDEX_DIR=data/index
CHROMA_COLLECTION=vtu_notes
