{
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "exam_mode": {
            "default": false,
            "title": "Exam Mode",
            "type": "boolean"
          },
          "k": {
            "anyOf": [
              {
                "maximum": 12.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "K"
          },
          "marks": {
            "default": 10,
            "enum": [
              5,
              10
            ],
            "title": "Marks",
            "type": "integer"
          },
          "question": {
            "maxLength": 500,
            "minLength": 3,
            "title": "Question",
            "type": "string"
          },
          "scopes": {
            "anyOf": [
              {
                "items": {
                  "enum": [
                    "curated",
                    "private",
                    "community"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "library tiers to search; omit for the public tiers",
            "title": "Scopes"
          },
          "subject": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "Body_create_upload_uploads_post": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          },
          "subject": {
            "default": "General",
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_create_upload_uploads_post",
        "type": "object"
      },
      "DevLogin": {
        "properties": {
          "email": {
            "maxLength": 200,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "DevLogin",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "OfferRequest": {
        "properties": {
          "attested": {
            "description": "the uploader confirms they may share this",
            "title": "Attested",
            "type": "boolean"
          }
        },
        "required": [
          "attested"
        ],
        "title": "OfferRequest",
        "type": "object"
      },
      "ReviewRequest": {
        "properties": {
          "note": {
            "default": "",
            "maxLength": 500,
            "title": "Note",
            "type": "string"
          }
        },
        "title": "ReviewRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Cited question answering over VTU notes PDFs, with a moderated contribution library.",
    "title": "VTU Notes RAG",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
